# Environment Configuration
# Copy this file to .env and customize as needed
# For development: values have defaults in docker-compose.dev.yaml

# Postgres (shared by Dagster and DuckLake containers)
POSTGRES_USER=dagster
POSTGRES_PASSWORD=dagster
POSTGRES_DB=dagster
# POSTGRES_PORT=5432

# Data Directories
# All application storage defaults to .data/ (testdata lives in data/)
# POSTGRES_DATA=./.data/postgres
# DAGSTER_COMPUTE_LOGS=./.data/dagster/compute_logs

# Dagster Configuration
DAGSTER_MODULE=pluginlake.definitions
DAGSTER_PG_HOST=postgres
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=dagster
DAGSTER_PG_DB=dagster
# DAGSTER_PORT=3000

# DuckLake catalog (PostgreSQL metadata store)
DUCKLAKE_PG_HOST=localhost
DUCKLAKE_PG_PORT=5432
DUCKLAKE_PG_USER=dagster
DUCKLAKE_PG_PASSWORD=dagster
DUCKLAKE_PG_DB=ducklake

# OMOP Module Configuration
# Paths default to .data/ — override only to mount external data sources
# OMOP_RAW_DATA_DIR=.data/raw/omop
# OMOP_VOCABULARY_DIR=.data/omop_vocabularies
# FHIR_RAW_DATA_DIR=.data/raw/fhir
# OMOP_VALIDATE_ON_LOAD=true
# OMOP_VALIDATE_FOREIGN_KEYS=false
# OMOP_SKIP_INVALID_ROWS=false
# OMOP_BATCH_SIZE=100000
# OMOP_CSV_ENCODING=utf-8
# OMOP_CDM_VERSION=5.4

# Datastation identity
DASHBOARD_DATASTATION_ID=ds-local-001
DASHBOARD_DATASTATION_NAME=demo-1

# Volumes (optional overrides)
# POSTGRES_DATA=.data/postgres
# DAGSTER_COMPUTE_LOGS=.data/dagster/compute_logs
