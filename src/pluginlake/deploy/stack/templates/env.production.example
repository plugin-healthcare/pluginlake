# Production configuration of a pluginlake station (non-secret).
# Copy to .env.production in the station directory (next to pluginlake.toml).
# Loaded into the containers (env_file) and used by compose for interpolation.
# Passwords do NOT go here: each is a file in secrets/ (docs/guides/docker.md#secrets).
# POSTGRES_USER, DAGSTER_PG_USER and DUCKLAKE_PG_USER are the same user below, so
# secrets/postgres_password, dagster_pg_password and ducklake_pg_password must be equal.

# Postgres
POSTGRES_USER=dagster
POSTGRES_DB=dagster

# Dagster
DAGSTER_PG_HOST=postgres
DAGSTER_PG_USER=dagster
DAGSTER_PG_DB=dagster

# DuckLake catalog
DUCKLAKE_PG_USER=dagster

# DuckDB limits per connection (API and Dagster runs). Over these, a query spills to
# DUCKLAKE_TEMP_DIRECTORY on the data volume; beyond that it fails with a clear error
# (HTTP 507 in the API). PLUGINLAKE_API_MEM_LIMIT caps the whole API container.
# DUCKLAKE_MEMORY_LIMIT=2GB
# DUCKLAKE_MAX_TEMP_DIRECTORY_SIZE=10GB
# DUCKLAKE_TEMP_DIRECTORY=.data/tmp/duckdb
# PLUGINLAKE_API_MEM_LIMIT=4g

# Monitoring (profile `monitoring`): database user of postgres-exporter.
# Prefer a dedicated read-only user: CREATE ROLE monitoring LOGIN PASSWORD '...' IN ROLE pg_monitor;
# POSTGRES_EXPORTER_USER=monitoring

# Lineage (profile `lineage`)
# MARQUEZ_DB=marquez
# MARQUEZ_DB_USER=marquez

# Host ports. Only the API listens on all interfaces; the others on 127.0.0.1.
# PLUGINLAKE_SERVER_PORT=8000
# DAGSTER_WEBSERVER_PORT=3000
# DASHBOARD_HOST_PORT=8501
# PROMETHEUS_PORT=9090
# MARQUEZ_WEB_PORT=3001

# Dashboard
# DASHBOARD_DATASTATION_ID=ds-001
# DASHBOARD_DATASTATION_NAME=ds-001
