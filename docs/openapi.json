        },
        "type": "object",
        "required": [
          "max_file_size_mb",
          "allowed_extensions"
        ],
        "title": "IngestionInfoResponse",
        "description": "Response for the ingestion info endpoint.\n\nAttributes:\n    max_file_size_mb: Maximum allowed file size in megabytes.\n    allowed_extensions: List of allowed file extensions."
      },
      "IngestionResponse": {
        "properties": {
          "file_id": {
            "type": "string",
            "title": "File Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "dataset": {
            "type": "string",
            "title": "Dataset"
          },
          "file_path": {
            "type": "string",
            "title": "File Path"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "dagster_run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dagster Run Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "file_id",
          "filename",
          "dataset",
          "file_path",
          "size_bytes",
          "dagster_run_id",
          "status",
          "message"
        ],
        "title": "IngestionResponse",
        "description": "Response returned after a successful file ingestion.\n\nAttributes:\n    file_id: Unique identifier assigned to the uploaded file.\n    filename: Original filename.\n    dataset: Target dataset name.\n    file_path: Storage path where the file was written.\n    size_bytes: Size of the file in bytes.\n    dagster_run_id: Dagster run ID if triggered, else null.\n    status: ``completed`` if Dagster was triggered, ``stored`` otherwise.\n    message: Human-readable summary."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
