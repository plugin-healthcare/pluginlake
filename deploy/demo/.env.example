# Copy to deploy/demo/.env (gitignored). Used by the `just demo-vm*` recipes on your workstation.
# SSH target of the VM over Tailscale, e.g. demo-admin@<machine name>.
DEMO_SSH=
# Your tailnet's domain (Tailscale admin console, DNS page), e.g. example.ts.net.
DEMO_DOMAIN=
# Pushed branch or tag that contains deploy/demo; the VM checks it out.
DEMO_REF=
# Optional: Scaleway server name, image registry and tag.
# DEMO_VM_NAME=pluginlake-demo
# DEMO_REGISTRY=ghcr.io/plugin-healthcare
# DEMO_TAG=demo
# 0 uses the images copied with `just demo-images-copy` instead of pulling them from the registry.
DEMO_PULL=0
# Optional: patients kept from the Synthea FHIR set by `just demo-vm data`; 0 keeps all 51k, which needs more than 8 GB memory.
# DEMO_FHIR_PATIENTS=1000
# Optional: repository the VM clones, and the local inputs of `just demo-images`.
# DEMO_REPO=https://github.com/plugin-healthcare/pluginlake.git
# DEMO_EHDS_DIR=../pluginlake-ehds-demo
# DEMO_WHEELS_DIR=.agents/runbook/demo/wheels
