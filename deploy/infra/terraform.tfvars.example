# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to version control.

# Find your subscription ID with: az account show --query id -o tsv
subscription_id = "00000000-0000-0000-0000-000000000000"

resource_group_name = "rg-plugin-demo-d"
location            = "westeurope"

# Container Registry
acr_name = "cr-plugin-demo-d"
acr_sku  = "Basic"

# Storage Account
storage_account_name     = "st-plugin-demo-d"
storage_account_tier     = "Standard"
storage_replication_type = "LRS"

# Optional: pre-create blob containers
# storage_containers = ["raw", "processed", "output"]

# ACR — set these to the Object IDs of the principals that need ACR access.
# Find an Object ID with: az ad sp show --id <APP_ID> --query id -o tsv
# acr_pull_principal_object_id = "00000000-0000-0000-0000-000000000000"  # pull-only (e.g. deployment runners)
# acr_push_principal_object_id = "00000000-0000-0000-0000-000000000000"  # push + pull (e.g. CI/CD pipelines)

# Storage — Object ID of the SP that gets Storage Blob Data Contributor access.
# service_principal_object_id = "00000000-0000-0000-0000-000000000000"

tags = {
  project     = "pluginlake"
  environment = "demo"
  managed_by  = "opentofu"
}
