# Copy to .env (gitignored) and fill in. `just demo-tofu` sources it as Bash, so single-quote values with spaces or $.
# Keep the passphrase in the team password manager as well: without it the state cannot be decrypted.
TF_VAR_state_passphrase=
# Private, versioned Object Storage bucket in fr-par that holds the encrypted state.
TOFU_STATE_BUCKET=
TF_VAR_ssh_public_key='ssh-ed25519 AAAA... admin@example'
# Output of `openssl passwd -6`, never the password itself.
TF_VAR_console_password_hash='$6$...'
