# pluginlake environment
#
# Copy and fill in:
#   cp .env.example .env
#
# Dev: defaults work out of the box (simple passwords, local paths)
# Prod: generate real passwords, set XDG paths, adjust ports

# --- PostgreSQL (shared by Dagster + DuckLake) ---
POSTGRES_USER=pluginlake
POSTGRES_PASSWORD=pluginlake
POSTGRES_PORT=5432

# --- Dagster ---
DAGSTER_PG_DB=dagster
DAGSTER_PORT=3000

# --- DuckLake ---
DUCKLAKE_PG_DB=ducklake

# --- pluginlake API ---
PLUGINLAKE_SERVER_PORT=8000
CODE_SERVER_PORT=4000

# --- Instance identity (used by dashboard + CLI) ---
DATASTATION_ID=ds-local-001
DATASTATION_NAME=Local Dev

# --- Host user mapping (for production) ---
# PUID=1000
# PGID=1000

# --- Paths (production only — dev uses project-relative .data/) ---
# Generate real passwords: openssl rand -base64 32
# Create dirs: mkdir -p <STATE_DIR>/{dagster,logs/{compute,dagster}} <DATA_DIR>/storage
# PLUGINLAKE_CONFIG_DIR=~/.config/pluginlake/ds-001
# PLUGINLAKE_DATA_DIR=~/.local/share/pluginlake/ds-001
# PLUGINLAKE_STATE_DIR=~/.local/state/pluginlake/ds-001
