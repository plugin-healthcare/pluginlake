# Compose environment for the dev stack (docker-compose.dev.yaml, `pluginlake up`).
# Copy to deploy/compose/.env. Only docker compose reads this file: it is used for
# interpolation and as the source of the Docker secrets, never loaded into a container.

# Postgres (dev uses this superuser for every service)
POSTGRES_USER=dagster
POSTGRES_DB=dagster

# Dagster
DAGSTER_MODULE=pluginlake.definitions
DAGSTER_PG_DB=dagster

# Volumes (optional overrides)
# POSTGRES_DATA=../../.data/postgres
# DAGSTER_COMPUTE_LOGS=../../.data/dagster/compute_logs

# Secrets: mounted under /run/secrets/ in the services that need them.
POSTGRES_PASSWORD=dagster
# Required when the `monitoring` profile starts; empty when remote write is not used.
PROMETHEUS_REMOTE_WRITE_PASSWORD=
