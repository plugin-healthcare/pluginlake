# Production secrets for pluginlake. Copy to .env.production.secrets and chmod 600.
# NEVER commit .env.production.secrets to version control.
#
# Only docker compose reads this file (`just up` passes it with --env-file). Each
# value becomes a Docker secret under /run/secrets/ in the services that need it;
# it is never loaded into a container's environment.
# The same password may be used for several entries when they share a database user.

POSTGRES_PASSWORD=CHANGE_ME
DAGSTER_PG_PASSWORD=CHANGE_ME
DUCKLAKE_PG_PASSWORD=CHANGE_ME

# Monitoring (profile `monitoring`). Must be set when that profile starts;
# leave PROMETHEUS_REMOTE_WRITE_PASSWORD empty when remote write is not used.
POSTGRES_EXPORTER_PASSWORD=CHANGE_ME
PROMETHEUS_REMOTE_WRITE_PASSWORD=
