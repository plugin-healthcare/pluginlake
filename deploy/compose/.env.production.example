# Production configuration for pluginlake (non-secret). Every value is required: compose has no defaults.
# `just init-env` copies this file to .env.production and sets the host user.
# NEVER commit .env.production to version control.
# Loaded into the containers (env_file) and used by compose for interpolation.
# Passwords are not set here: `just up` generates them as files in PLUGINLAKE_HOME/secrets.

# Postgres superuser: used by Postgres and pluginlake-db-init only. Every service has its own role below.
POSTGRES_USER=postgres
POSTGRES_DB=postgres

# Dagster
DAGSTER_PG_HOST=postgres
DAGSTER_PG_USER=dagster
DAGSTER_PG_DB=dagster

# DuckLake catalog
DUCKLAKE_PG_USER=ducklake
DUCKLAKE_PG_DB=ducklake

# API server
PLUGINLAKE_SERVER_HOST=0.0.0.0
PLUGINLAKE_SERVER_PORT=8000

# Monitoring (profile `monitoring`): read-only role (pg_monitor) of postgres-exporter.
POSTGRES_EXPORTER_USER=monitoring

# Lineage (profile `lineage`)
MARQUEZ_DB=marquez
MARQUEZ_DB_USER=marquez

# Zitadel database role (created by pluginlake-db-init)
ZITADEL_DB_USER=zitadel
ZITADEL_DB=zitadel

# Edge (Traefik, Zitadel, oauth2-proxy)
# Services live on api., dagster., dashboard., marquez., prometheus. and auth. subdomains.
PLUGINLAKE_DOMAIN=pluginlake.localhost
# Set to true only while Traefik serves its self-signed certificate (local use).
OAUTH2_PROXY_INSECURE_TLS=true
ZITADEL_ADMIN_USERNAME=admin

# Host user and data folder
# All containers run as this user and keep their data below PLUGINLAKE_HOME (relative to deploy/compose).
# `just init-env` overwrites the uid and gid with those of the current user.
PLUGINLAKE_UID=1000
PLUGINLAKE_GID=1000
PLUGINLAKE_HOME=./.pluginlake
