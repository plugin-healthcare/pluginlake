# Production configuration for pluginlake (non-secret).
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to version control.
# Loaded into the containers (env_file) and used by compose for interpolation.
# Passwords do NOT go here: put them in .env.production.secrets (see that example).

# Postgres
POSTGRES_USER=dagster
POSTGRES_DB=dagster

# Dagster
DAGSTER_PG_HOST=postgres
DAGSTER_PG_USER=dagster
DAGSTER_PG_DB=dagster

# DuckLake catalog
DUCKLAKE_PG_USER=dagster

# Monitoring (profile `monitoring`): database user of postgres-exporter.
# Prefer a dedicated read-only user: CREATE ROLE monitoring LOGIN PASSWORD '...' IN ROLE pg_monitor;
# POSTGRES_EXPORTER_USER=monitoring
