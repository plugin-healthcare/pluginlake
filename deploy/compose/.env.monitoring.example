# Prometheus settings and secrets for the `monitoring` compose profile (ADR-010).
# Copy to .env.monitoring and fill in. NEVER commit .env.monitoring.
# Only the prometheus service reads this file.

# Central Prometheus remote write (optional). The URL can also be set as
# [monitoring] remote_write_url in pluginlake.toml, which takes precedence.
# Must use https://; never put credentials in the URL.
PROMETHEUS_REMOTE_WRITE_URL=
PROMETHEUS_REMOTE_WRITE_USERNAME=
PROMETHEUS_REMOTE_WRITE_PASSWORD=

# Set by `pluginlake up` from pluginlake.toml; only needed when running compose directly.
# PROMETHEUS_STATION_ID=ds-001
# PROMETHEUS_SCRAPE_CADVISOR=true
# PROMETHEUS_RETENTION=15d
