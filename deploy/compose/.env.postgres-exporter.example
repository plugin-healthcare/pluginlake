# postgres-exporter credentials for the `monitoring` profile of the production compose (ADR-010).
# Copy to .env.postgres-exporter and fill in. NEVER commit .env.postgres-exporter.
# Only the postgres-exporter service reads this file; the dev compose reuses POSTGRES_USER.
# Prefer a dedicated read-only user: CREATE ROLE monitoring LOGIN PASSWORD '...' IN ROLE pg_monitor;
DATA_SOURCE_USER=
DATA_SOURCE_PASS=
