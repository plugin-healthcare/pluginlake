# pluginlake deployment environment
# Generated by: pluginlake init
# Manual setup: copy this file, fill values, and place at
#   ~/.config/pluginlake/<instance-id>/.env

# --- Instance identity ---
DATASTATION_ID=
DATASTATION_NAME=

# --- Host user mapping ---
PUID=1000
PGID=1000

# --- PostgreSQL (shared by Dagster + DuckLake) ---
POSTGRES_USER=pluginlake
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Dagster ---
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=pluginlake
DAGSTER_PG_PASSWORD=
DAGSTER_PORT=3000

# --- DuckLake ---
DUCKLAKE_PG_DB=ducklake
DUCKLAKE_PG_USER=pluginlake
DUCKLAKE_PG_PASSWORD=

# --- pluginlake API ---
PLUGINLAKE_SERVER_PORT=8000
CODE_SERVER_PORT=4000

# --- Paths (XDG directories) ---
# Set these to the instance directories created by `pluginlake init`
# or create them manually following the structure below:
#   config: ~/.config/pluginlake/<id>/
#   data:   ~/.local/share/pluginlake/<id>/
#   state:  ~/.local/state/pluginlake/<id>/
PLUGINLAKE_CONFIG_DIR=
PLUGINLAKE_DATA_DIR=
PLUGINLAKE_STATE_DIR=
